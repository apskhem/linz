{
  "compilerOptions": {
    "target": "es2023",
    // esbuild bundles the app and tsx runs it in development, so imports need no file extensions
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["src", "scripts"]
}
