{
  "name": "@apskhem/linz-example-bootstrap",
  "version": "1.0.0",
  "description": "A starting point for building an HTTP API with Linz.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "check": "tsc --noEmit",
    "openapi": "tsx scripts/write-openapi.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apskhem/linz": "file:../..",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
