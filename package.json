{
  "name": "@apskhem/linz",
  "version": "0.20.0",
  "description": "A web framework with first-class OpenAPI documentation support.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apskhem/linz.git"
  },
  "keywords": [],
  "author": "Apisit Ritruengroj",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "npx tsup",
    "test": "jest",
    "fmt": "prettier --write './src/**/*.ts'",
    "lint": "npx oxlint src",
    "lint:fix": "npx oxlint src --fix"
  },
  "dependencies": {
    "@routejs/router": "^3.0.3",
    "cors": "^2.8.5",
    "fast-content-type-parse": "^3.0.0",
    "http-status": "~1.7.4",
    "openapi-types": "^12.1.3",
    "radash": "^12.1.1"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "html-minifier-terser": "^7.2.0",
    "oxlint": "^1.30.0",
    "prettier": "^3.7.1",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "zod": "^4.1.13"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "hbs"
    ],
    "rootDir": "tests",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest",
      "^.+\\.hbs$": "<rootDir>/helpers/text-transform.js"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
