{
  "name": "@apskhem/linz",
  "version": "0.20.0",
  "description": "A web framework with first-class OpenAPI documentation support.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apskhem/linz.git"
  },
  "keywords": [],
  "author": "Apisit Ritruengroj",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/write-esm-types.mjs",
    "test": "vitest run",
    "test:e2e": "tsup --out-dir e2e/.build && node e2e/run.mjs",
    "bench": "tsup --out-dir bench/.build && node bench/run.mjs",
    "lint": "oxlint src tests e2e bench",
    "lint:fix": "oxlint src tests e2e bench --fix"
  },
  "dependencies": {
    "@routejs/router": "^3.0.3",
    "cors": "^2.8.6",
    "fast-content-type-parse": "^4.0.1",
    "http-status": "^2.1.0",
    "openapi-types": "^12.1.3",
    "radash": "^12.1.1"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@orangeopensource/hurl": "^8.0.4",
    "@types/cors": "^2.8.19",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.5",
    "autocannon": "^8.0.0",
    "html-minifier-terser": "^7.2.0",
    "oxlint": "^1.89.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
