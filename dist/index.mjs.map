<!DOCTYPE html><html><head><title>{{title}}</title><meta charset="UTF-8"><style>body{margin:0;padding:0}#redoc-container{height:100vh}</style><script src="https://cdn.jsdelivr.net/npm/redoc@2.5.4/bundles/redoc.standalone.js" integrity="sha384-w447zOpYfw/1Tv/5AK9NfHTlQIqE3RVR6KY62jCyy9zNDgO64cMwGGP1Fj0zJVf5" crossorigin="anonymous"></script></head><body><div id="redoc-container"></div><script>document.addEventListener("DOMContentLoaded",function(){Redoc.init("{{js:specUrl}}",{scrollYOffset:50,hideDownloadButton:!1,theme:{colors:{primary:{main:"#3498db"}}}},document.getElementById("redoc-container"))})</script></body></html>